APP_NAME="Education Interntions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local default
DB_CONNECTION=sqlite

# Production / Supabase Postgres example
# DB_CONNECTION=pgsql
# DB_HOST=db.xxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require

# Optional read replica
# DB_READ_HOST=db-read.xxxxx.supabase.co

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
# Use s3 for durable uploads (Supabase Storage). Local: public
MEDIA_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wineducation.com"
MAIL_FROM_NAME="${APP_NAME}"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

LINE_CHANNEL_ID=

# Supabase Storage (S3-compatible) — production on Render:
# MEDIA_DISK=s3
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=...          # Storage > S3 > Access keys
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=ap-southeast-1
# AWS_BUCKET=media
# AWS_ENDPOINT=https://YOUR_PROJECT_REF.supabase.co/storage/v1/s3
# AWS_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1/object/public/media
# AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=media
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
